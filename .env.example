NODE_ENV=production

PORT=3000

DATABASE_URL=

REDIS_HOST=redis
REDIS_PORT=6379

FRONTEND_URL=https://your-domain.com

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

GAME_SESSION_SECRET=
GAME_SESSION_EXPIRES_IN=30m

MEDIA_STORAGE_PATH=/app/storage/media
MEDIA_MAX_FILE_SIZE=10485760
MEDIA_MAX_IMAGE_WIDTH=2400
MEDIA_MAX_IMAGE_HEIGHT=2400

RESOURCE_STORAGE_PATH=/app/storage/resources
RESOURCE_TEMP_PATH=/app/storage/resource-temp
RESOURCE_MAX_FILE_SIZE=104857600

LOG_LEVEL=info

POSTGRES_DB=terraDB
POSTGRES_USER=terra
POSTGRES_PASSWORD=