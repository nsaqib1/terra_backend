generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                @id @default(uuid()) @db.Uuid
  username          String                @unique @db.VarChar(30)
  displayName       String                @db.VarChar(100)
  email             String                @unique @db.VarChar(255)
  passwordHash      String
  avatarUrl         String?
  bio               String?
  status            UserStatus            @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  role              UserRole              @default(USER)
  points            Int                   @default(0)
  location          String?               @db.VarChar(150)
  website           String?               @db.VarChar(500)
  comments          Comment[]
  memberships       CommunityMembership[]
  proposals         CommunityProposal[]   @relation("ProposedBy")
  reviewedProposals CommunityProposal[]   @relation("ReviewedBy")
  dailyVisits       DailyVisit[]
  createdInvites    Invite[]              @relation("CreatedInvites")
  inviteUsage       InviteUsage?
  media             Media[]
  pointEvents       PointEvent[]
  posts             Post[]
  refreshSessions   RefreshSession[]
  votes             Vote[]

  @@index([status])
  @@index([deletedAt])
}

model Community {
  id             String                @id @default(uuid()) @db.Uuid
  name           String                @db.VarChar(100)
  slug           String                @unique @db.VarChar(100)
  description    String?
  status         CommunityStatus       @default(ACTIVE)
  maturity       CommunityMaturity     @default(NEW)
  governanceMode GovernanceMode        @default(PLATFORM_MANAGED)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  memberships    CommunityMembership[]
  proposals      CommunityProposal[]
  posts          Post[]
  tags           Tag[]

  @@index([status])
  @@index([maturity])
  @@index([deletedAt])
}

model CommunityProposal {
  id           String                  @id @default(uuid()) @db.Uuid
  proposedName String                  @db.VarChar(100)
  proposedSlug String                  @db.VarChar(100)
  description  String?
  reason       String?
  status       CommunityProposalStatus @default(PENDING)
  proposedById String                  @db.Uuid
  reviewedById String?                 @db.Uuid
  reviewReason String?
  reviewedAt   DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  communityId  String?                 @db.Uuid
  community    Community?              @relation(fields: [communityId], references: [id])
  proposedBy   User                    @relation("ProposedBy", fields: [proposedById], references: [id])
  reviewedBy   User?                   @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([proposedById])
  @@index([reviewedById])
  @@index([status])
  @@index([communityId])
}

model CommunityMembership {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  communityId String              @db.Uuid
  role        CommunityMemberRole @default(CITIZEN)
  joinedAt    DateTime            @default(now())
  leftAt      DateTime?
  community   Community           @relation(fields: [communityId], references: [id])
  user        User                @relation(fields: [userId], references: [id])

  @@unique([userId, communityId])
  @@index([communityId])
  @@index([userId])
  @@index([role])
}

model Post {
  id           String     @id @default(uuid()) @db.Uuid
  communityId  String     @db.Uuid
  authorId     String     @db.Uuid
  score        Int        @default(0)
  commentCount Int        @default(0)
  status       PostStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  document     Json
  searchText   String
  comments     Comment[]
  media        Media[]
  author       User       @relation(fields: [authorId], references: [id])
  community    Community  @relation(fields: [communityId], references: [id])
  tags         PostTag[]
  votes        Vote[]

  @@index([communityId, createdAt])
  @@index([communityId, score])
  @@index([authorId, createdAt])
  @@index([status])
  @@index([deletedAt])
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @db.Uuid
  authorId  String    @db.Uuid
  parentId  String?   @db.Uuid
  body      String
  score     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  author    User      @relation(fields: [authorId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  post      Post      @relation(fields: [postId], references: [id])
  votes     Vote[]

  @@index([postId, createdAt])
  @@index([postId, score])
  @@index([authorId])
  @@index([parentId])
  @@index([deletedAt])
}

model Tag {
  id          String    @id @default(uuid()) @db.Uuid
  communityId String    @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @db.VarChar(100)
  description String?
  status      TagStatus @default(ACTIVE)
  usageCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  posts       PostTag[]
  community   Community @relation(fields: [communityId], references: [id])

  @@unique([communityId, slug])
  @@index([communityId])
  @@index([communityId, status])
}

model PostTag {
  postId String @db.Uuid
  tagId  String @db.Uuid
  post   Post   @relation(fields: [postId], references: [id])
  tag    Tag    @relation(fields: [tagId], references: [id])

  @@id([postId, tagId])
  @@index([tagId])
}

model Media {
  id               String      @id @default(uuid()) @db.Uuid
  uploadedById     String      @db.Uuid
  postId           String?     @db.Uuid
  type             MediaType
  status           MediaStatus @default(ACTIVE)
  storageKey       String
  mimeType         String      @db.VarChar(100)
  width            Int?
  height           Int?
  size             Int?
  altText          String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?
  originalFilename String?     @db.VarChar(255)
  post             Post?       @relation(fields: [postId], references: [id])
  uploadedBy       User        @relation(fields: [uploadedById], references: [id])

  @@index([uploadedById])
  @@index([postId])
  @@index([status])
  @@index([deletedAt])
}

model Vote {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  postId    String?   @db.Uuid
  commentId String?   @db.Uuid
  value     VoteValue
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comment   Comment?  @relation(fields: [commentId], references: [id])
  post      Post?     @relation(fields: [postId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
  @@index([commentId])
  @@index([userId])
}

model PointEvent {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @db.Uuid
  type       PointEventType
  points     Int
  sourceType PointSourceType
  sourceId   String?         @db.Uuid
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([type])
  @@index([sourceType, sourceId])
}

model DailyVisit {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  visitDate DateTime @db.Date
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, visitDate])
  @@index([userId, visitDate])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  userAgent String?
  ipAddress String?   @db.VarChar(45)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Invite {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique @db.VarChar(50)
  label       String?       @db.VarChar(100)
  maxUses     Int           @default(1)
  usedCount   Int           @default(0)
  expiresAt   DateTime?
  isActive    Boolean       @default(true)
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User?         @relation("CreatedInvites", fields: [createdById], references: [id])
  usages      InviteUsage[]

  @@index([code])
  @@index([isActive])
  @@index([createdById])
  @@index([createdAt])
}

model InviteUsage {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @unique @db.Uuid
  usedAt   DateTime @default(now())
  inviteId String   @db.Uuid
  invite   Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([inviteId])
  @@index([userId])
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum CommunityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CommunityMaturity {
  NEW
  GROWING
  ESTABLISHED
  SELF_GOVERNED
}

enum GovernanceMode {
  PLATFORM_MANAGED
  SELF_GOVERNED
}

enum CommunityMemberRole {
  CITIZEN
  MODERATOR
}

enum CommunityProposalStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum PostStatus {
  ACTIVE
  LOCKED
  REMOVED
}

enum VoteValue {
  UP
  DOWN
}

enum ReputationEventType {
  POST_CREATED
  COMMENT_CREATED
  POST_UPVOTED
  COMMENT_UPVOTED
}

enum ReputationSourceType {
  POST
  COMMENT
  VOTE
  SYSTEM
}

enum TagStatus {
  ACTIVE
  ARCHIVED

  @@map("TagStatus")
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStatus {
  ACTIVE
  DELETED
  TEMPORARY
}

enum PointEventType {
  DAILY_VISIT
  POST_CREATED
  COMMENT_CREATED
  POST_UPVOTED
  COMMENT_UPVOTED
  SYSTEM
}

enum PointSourceType {
  POST
  COMMENT
  VOTE
  SYSTEM
}
